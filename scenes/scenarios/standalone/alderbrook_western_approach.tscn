[node name="Mission" type="Node2D" parent="Scenarios" unique_id=863863419]
script = ExtResource("17_203f7")
scenario_name = "Alderbrook: The Western Approach"
scenario_id = "alderbrook_western_approach"
scenario_description = "Standalone alternative to Battle for Alderbrook.

Your company has reached the western outskirts. Fields give way to an orchard estate, roadside houses and workshop yards, then tight town blocks. There is no river barrier: move between the approaches and choose where to commit your reserve.

[b]North - Orchard estate (A):[/b] the orchard conceals the approach but hinders fire. Clear its edge and use the estate to turn the market defense.
[b]Center - Market square (B):[/b] the main road is fast and exposed. Cover the approach from the roadside houses, or enter the square from a flank.
[b]South - Workshop yard (C):[/b] scattered timber sheds provide stepping stones into town. Take the yard, then use the diagonal street to support the market assault.

Three rifle platoons each have a machine-gun team. Company HQ and a light mortar support the attack. Keep one platoon available until you identify the weaker approach. Enemy infantry and machine guns defend the outskirts, with mortar support deeper in town.

[b]Major Victory:[/b] hold A, B and C simultaneously, each for 30 uninterrupted seconds. This ends the battle immediately.
[b]Minor Victory:[/b] hold B for 30 uninterrupted seconds at the 15-minute deadline.

Objectives require a unit in good order; enemy presence contests control. There are no destruction or exit quotas. The defenders win by holding all three districts at the deadline, or earn a minor victory by holding B."
duration_s = 900.0
use_authored_duration = true
released = true
player_team = 1
victory_conditions = Array[ExtResource("18_ncxt2")]([SubResource("Resource_v17ed"), SubResource("Resource_1et88"), SubResource("Resource_k7vpc"), SubResource("Resource_v3pi7"), SubResource("Resource_vxkrw"), SubResource("Resource_6v4pp"), SubResource("Resource_6khyr"), SubResource("Resource_2n6pb")])
axis_ai_status = 1
allies_ai_status = 0

