[gd_scene format=3]

[ext_resource type="Theme" path="res://resources/theme/battle_hud_theme.tres" id="hud_theme"]

[ext_resource type="Script" path="res://scenes/ui/units/unit_details_panel.gd" id="1"]
[ext_resource type="PackedScene" path="res://scenes/ui/units/selected_soldier_row.tscn" id="2"]
[ext_resource type="Script" path="res://scenes/ui/orders/rout_button.gd" id="3"]
[ext_resource type="Script" path="res://scenes/ui/units/unit_type_label.gd" id="5"]
[ext_resource type="Script" path="res://scenes/ui/units/leadership_bonus_label.gd" id="7"]

[sub_resource type="StyleBoxFlat" id="BarBackground"]
bg_color = Color(0.2, 0.2, 0.17, 1)

[sub_resource type="StyleBoxFlat" id="CohesionFill"]
bg_color = Color(0.49, 0.67, 0.4, 1)

[sub_resource type="StyleBoxFlat" id="EffectivenessFill"]
bg_color = Color(0.74, 0.6, 0.35, 1)

[node name="UnitDetails" type="PanelContainer"]
visible = false
custom_minimum_size = Vector2(300, 0)
anchors_preset = 3
anchor_left = 1.0
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = -312.0
offset_top = -192.0
offset_right = -12.0
offset_bottom = -12.0
grow_horizontal = 0
grow_vertical = 0
mouse_force_pass_scroll_events = false
theme = ExtResource("hud_theme")
script = ExtResource("1")
soldier_detail_row_scene = ExtResource("2")

[node name="Summary" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 4

[node name="Identity" type="Label" parent="Summary"]
layout_mode = 2
mouse_filter = 1
text = "A · Rifle Squad"
text_overrun_behavior = 3
clip_text = true
script = ExtResource("5")
theme_type_variation = &"HudHeading"

[node name="Formation" type="Label" parent="Summary"]
layout_mode = 2
text = "Company A · Platoon 1 · Squad 1"
text_overrun_behavior = 3
clip_text = true
theme_type_variation = &"HudSecondary"

[node name="Status" type="VBoxContainer" parent="Summary"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="Strength" type="Label" parent="Summary/Status"]
layout_mode = 2
mouse_filter = 1
text = "Soldiers: 12/12"
clip_text = true

[node name="Morale" type="Label" parent="Summary/Status"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 1
text = "Morale: Ok"
text_overrun_behavior = 3
clip_text = true

[node name="Order" type="Label" parent="Summary"]
layout_mode = 2
mouse_filter = 1
text = "Order: Hold position"
text_overrun_behavior = 3
clip_text = true

[node name="Stats" type="GridContainer" parent="Summary"]
layout_mode = 2
theme_override_constants/h_separation = 6
theme_override_constants/v_separation = 3
columns = 3

[node name="CohesionLabel" type="Label" parent="Summary/Stats"]
layout_mode = 2
text = "Cohesion"
theme_type_variation = &"HudSecondary"
custom_minimum_size = Vector2(96, 0)

[node name="CohesionBar" type="ProgressBar" parent="Summary/Stats"]
custom_minimum_size = Vector2(0, 8)
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
theme_override_styles/background = SubResource("BarBackground")
theme_override_styles/fill = SubResource("CohesionFill")
max_value = 1.0
step = 0.001
show_percentage = false

[node name="Cohesion" type="Label" parent="Summary/Stats"]
custom_minimum_size = Vector2(32, 0)
layout_mode = 2
text = "100%"
horizontal_alignment = 2

[node name="EffectivenessLabel" type="Label" parent="Summary/Stats"]
layout_mode = 2
text = "Effectiveness"
theme_type_variation = &"HudSecondary"

[node name="EffectivenessBar" type="ProgressBar" parent="Summary/Stats"]
custom_minimum_size = Vector2(0, 8)
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
theme_override_styles/background = SubResource("BarBackground")
theme_override_styles/fill = SubResource("EffectivenessFill")
max_value = 1.0
step = 0.001
show_percentage = false

[node name="Effectiveness" type="Label" parent="Summary/Stats"]
layout_mode = 2
text = "100%"
horizontal_alignment = 2

[node name="Rout" type="Button" parent="Summary"]
visible = false
layout_mode = 2
disabled = true
