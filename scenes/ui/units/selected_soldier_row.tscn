[gd_scene format=3]

[sub_resource type="StyleBoxFlat" id="Background"]
bg_color = Color(0.2, 0.2, 0.17, 1)

[sub_resource type="StyleBoxFlat" id="Fill"]
bg_color = Color(0.74, 0.6, 0.35, 1)

[node name="SoldierRow" type="VBoxContainer"]
theme_override_constants/separation = 2

[node name="Identity" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Name" type="Label" parent="Identity"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 1
text_overrun_behavior = 3
clip_text = true

[node name="Role" type="Label" parent="Identity"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 1
horizontal_alignment = 2
text_overrun_behavior = 3
clip_text = true
theme_type_variation = &"HudSecondary"

[node name="Activity" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Weapon" type="Label" parent="Activity"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 1
text_overrun_behavior = 3
clip_text = true
theme_type_variation = &"HudSecondary"

[node name="Task" type="VBoxContainer" parent="Activity"]
custom_minimum_size = Vector2(96, 0)
layout_mode = 2
theme_override_constants/separation = 1

[node name="Label" type="Label" parent="Activity/Task"]
layout_mode = 2
mouse_filter = 1
horizontal_alignment = 2
text_overrun_behavior = 3
clip_text = true
theme_type_variation = &"HudSecondary"

[node name="Progress" type="ProgressBar" parent="Activity/Task"]
custom_minimum_size = Vector2(0, 4)
layout_mode = 2
theme_override_styles/background = SubResource("Background")
theme_override_styles/fill = SubResource("Fill")
max_value = 1.0
step = 0.001
show_percentage = false
