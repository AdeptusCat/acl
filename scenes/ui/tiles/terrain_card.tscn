[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/ui/tiles/tile_details_panel.gd" id="1"]
[ext_resource type="FontFile" path="res://assets/fonts/courier_prime/Courier Prime.ttf" id="2"]

[sub_resource type="StyleBoxFlat" id="PanelStyle"]
content_margin_left = 10.0
content_margin_top = 8.0
content_margin_right = 10.0
content_margin_bottom = 8.0
bg_color = Color(0.08, 0.08, 0.08, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.63, 0.46, 0.27, 1)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4

[sub_resource type="Theme" id="TerrainTheme"]
default_font = ExtResource("2")
default_font_size = 11
Label/colors/font_color = Color(0.9, 0.87, 0.77, 1)
Button/font_sizes/font_size = 12
FoldableContainer/font_sizes/font_size = 11
TooltipPanel/styles/panel = SubResource("PanelStyle")
TooltipLabel/colors/font_color = Color(0.95, 0.93, 0.85, 1)
TooltipLabel/font_sizes/font_size = 12

[node name="TileDetails" type="PanelContainer"]
visible = false
custom_minimum_size = Vector2(240, 0)
anchors_preset = 2
anchor_top = 1.0
anchor_bottom = 1.0
offset_left = 12.0
offset_top = -104.0
offset_right = 252.0
offset_bottom = -12.0
grow_vertical = 0
mouse_force_pass_scroll_events = false
theme = SubResource("TerrainTheme")
theme_override_styles/panel = SubResource("PanelStyle")
script = ExtResource("1")

[node name="Content" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 3

[node name="Heading" type="HBoxContainer" parent="Content"]
layout_mode = 2

[node name="Terrain" type="Label" parent="Content/Heading"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 13
text = "Open ground"
text_overrun_behavior = 3
clip_text = true

[node name="Close" type="Button" parent="Content/Heading"]
custom_minimum_size = Vector2(18, 18)
layout_mode = 2
tooltip_text = "Close terrain inspection (Esc)"
text = "×"

[node name="Cover" type="Label" parent="Content"]
layout_mode = 2
tooltip_text = "Protection inside this hex. Edge cover only protects from the marked side."
text = "Hex cover: none"

[node name="Sight" type="Label" parent="Content"]
layout_mode = 2
text = "Sight: clear inside hex"

[node name="Details" type="FoldableContainer" parent="Content"]
layout_mode = 2
folded = true
title = "Terrain details"

[node name="Scroll" type="ScrollContainer" parent="Content/Details"]
visible = false
custom_minimum_size = Vector2(0, 240)
layout_mode = 2
mouse_force_pass_scroll_events = false
horizontal_scroll_mode = 0

[node name="Breakdown" type="VBoxContainer" parent="Content/Details/Scroll"]
size_flags_horizontal = 3
layout_mode = 2
theme_override_constants/separation = 5

[node name="Coordinates" type="Label" parent="Content/Details/Scroll/Breakdown"]
layout_mode = 2

[node name="Features" type="Label" parent="Content/Details/Scroll/Breakdown"]
layout_mode = 2

[node name="Heading" type="Label" parent="Content/Details/Scroll/Breakdown"]
layout_mode = 2
theme_override_colors/font_color = Color(0.8, 0.65, 0.45, 1)
text = "Protection from each side"

[node name="Edges" type="GridContainer" parent="Content/Details/Scroll/Breakdown"]
layout_mode = 2
theme_override_constants/v_separation = 2
columns = 2

[node name="Explanation" type="Label" parent="Content/Details/Scroll/Breakdown"]
layout_mode = 2
text = "Marked edges protect from that side.\nTarget cover also depends on the firing direction."
autowrap_mode = 2
