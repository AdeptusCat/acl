[node name="Mission" type="Node2D" parent="Scenarios" unique_id=393744908]
script = ExtResource("47_chuva")
scenario_name = "4. Two Crossings"
scenario_id = "alderbrook_04_two_crossings"
campaign_id = "road_to_alderbrook"
campaign_mission = 4
scenario_description = "Road to Alderbrook - mission 4 of 5.

Two reinforced platoons approach a narrow, single-hex-wide river winding through farmland. The northern bridge crosses beside a stone hamlet; the southern bridge lies farther east at a wooded timber yard. The crossings are staggered around the river's S bend. Water is impassable everywhere except the two bridges.

[b]A - Bridge hamlet:[/b] hedged fields lead to the northern bridge. Establish covering fire on the west bank, cross and secure the stone bridgehead house. Village walls and orchard edges give the defenders several positions near the road.
[b]B - Timber crossing:[/b] the southern farm lane approaches through woods and orchard plots. Clear the timber buildings beyond the bridge. The southern bridgehead has more woodland but fewer long views than the hamlet.

Bank roads connect your two approaches, and an eastern lane links the enemy's bridgeheads. Coordinate both platoons; leave a garrison at each objective while the remaining squads advance toward the eastern Exit markers.

[b]Major Victory:[/b] hold A and B for 20 seconds each and exit three units east. All three requirements must be met together.

[b]Minor Victory:[/b] exit two units by the deadline."
duration_s = 720.0
use_authored_duration = true
released = true
player_team = 1
victory_conditions = Array[ExtResource("48_mv620")]([SubResource("Resource_7vrku"), SubResource("Resource_m20rh"), SubResource("Resource_s118w"), SubResource("Resource_5m35y"), SubResource("Resource_gm074"), SubResource("Resource_n6lta")])
axis_ai_status = 1
allies_ai_status = 0

