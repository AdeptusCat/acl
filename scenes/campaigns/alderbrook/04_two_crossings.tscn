[node name="Mission" type="Node2D" parent="Scenarios" unique_id=1465863289]
script = ExtResource("47_chuva")
scenario_name = "4. Two Crossings"
scenario_id = "alderbrook_04_two_crossings"
campaign_id = "road_to_alderbrook"
campaign_mission = 4
scenario_description = "Road to Alderbrook - mission 4 of 5.

Two reinforced platoons must open the river crossings and move a force into the village approaches. The river is impassable away from the two bridges. Assign a platoon to each crossing; leave a garrison on each eastern bank while the remaining squads pass through.

Major: hold A and B for 20 seconds each and exit three units through the eastern Exit markers. All three requirements must be met together. Minor: exit two units by the deadline. Enemy infantry and fire support guard the eastern approaches."
duration_s = 720.0
use_authored_duration = true
released = true
player_team = 1
victory_conditions = Array[ExtResource("48_mv620")]([SubResource("Resource_4a2sn"), SubResource("Resource_1te0p"), SubResource("Resource_ilsgy"), SubResource("Resource_5i8vt"), SubResource("Resource_1mdus"), SubResource("Resource_0prfd")])
axis_ai_status = 1
allies_ai_status = 0

