[node name="Mission" type="Node2D" parent="Scenarios" unique_id=1119091746]
script = ExtResource("47_7jhly")
scenario_name = "3. The Roadblock"
scenario_id = "alderbrook_03_the_roadblock"
campaign_id = "road_to_alderbrook"
campaign_mission = 3
scenario_description = "Road to Alderbrook - mission 3 of 5.

An enemy column is trying to pass the roadblock and escape to the west. Your platoon has two machine-gun teams but no reinforcements. Cover the road and its woodland bypass, keep a rifle squad in reserve, and protect the western exits. The enemy starts beyond the wooded bend.

[b]Major Victory:[/b] destroy two enemy units and allow no enemy exits before the deadline.

[b]Minor Victory:[/b] hold A at the deadline while allowing no more than two exits. Three enemy exits give the enemy victory."
duration_s = 540.0
use_authored_duration = true
released = true
