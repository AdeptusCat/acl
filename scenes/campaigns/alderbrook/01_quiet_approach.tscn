[node name="Mission" type="Node2D" parent="Scenarios" unique_id=1770727197]
script = ExtResource("47_i5hbn")
scenario_name = "1. Quiet Approach"
scenario_id = "alderbrook_01_quiet_approach"
campaign_id = "road_to_alderbrook"
campaign_mission = 1
scenario_description = "Road to Alderbrook - mission 1 of 5.

A small patrol must secure a farm on the approach to the village. There is time to plan; the woodland belt screens your starting positions. Move one squad at a time while the other covers it, and keep the platoon headquarters close.

[b]Major Victory:[/b] occupy the farm at A for 15 seconds.

[b]Minor Victory:[/b] hold the rally point at B when time expires. A minor or major victory opens the next mission."
duration_s = 600.0
use_authored_duration = true
released = true
player_team = 1
