[node name="Mission" type="Node2D" parent="Scenarios" unique_id=1431082217]
script = ExtResource("47_cvsn4")
scenario_name = "2. Orchard Outpost"
scenario_id = "alderbrook_02_orchard_outpost"
campaign_id = "road_to_alderbrook"
campaign_mission = 2
scenario_description = "Road to Alderbrook - mission 2 of 5.

Your platoon and machine-gun team approach an orchard estate from the southwest. Irregular orchard plots and hedges divide the ground into short fields of fire. The main road enters from the northwest, bends below the farmhouse and leaves through the eastern fields. A narrower farm lane winds south toward your assembly area.

[b]B - Orchard barn:[/b] the barn anchors the middle of the estate. Hedged orchards screen the western approach, but gaps and the farm lane expose troops crossing between plots. Establish the machine gun before advancing through the next opening.
[b]A - Farmhouse:[/b] the northern stone farmhouse and its walled yard command the final approach. Work through the orchard compartments or make a wider, more exposed move through the eastern fields. Keep a rifle squad available to protect the barn after taking it.

[b]Major Victory:[/b] destroy two enemy units and hold the farmhouse at A for 30 seconds. Both requirements must be met.

[b]Minor Victory:[/b] hold the orchard barn at B for 30 seconds at the deadline."
duration_s = 600.0
use_authored_duration = true
released = true
player_team = 1
victory_conditions = Array[ExtResource("48_mifp1")]([SubResource("Resource_wh05p"), SubResource("Resource_1dt80"), SubResource("Resource_ukdny"), SubResource("Resource_tnr7k"), SubResource("Resource_jyj6a"), SubResource("Resource_y3qnw")])
axis_ai_status = 1
allies_ai_status = 0

