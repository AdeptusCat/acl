[node name="Mission" type="Node2D" parent="Scenarios" unique_id=221862816]
script = ExtResource("47_cvsn4")
scenario_name = "2. Orchard Outpost"
scenario_id = "alderbrook_02_orchard_outpost"
campaign_id = "road_to_alderbrook"
campaign_mission = 2
scenario_description = "Road to Alderbrook - mission 2 of 5.

Your full platoon now has a machine-gun team. Clear the orchard outpost before the company moves up. The central lane is quick but exposed; the orchard and northern woodland give covered alternatives. Set up the gun before sending rifle squads forward.

[b]Major Victory:[/b] destroy two enemy units and hold the farmhouse at A for 30 seconds. Both requirements must be met.

[b]Minor Victory:[/b] hold the orchard barn at B when time expires."
duration_s = 600.0
use_authored_duration = true
released = true
player_team = 1
