[node name="Mission" type="Node2D" parent="Scenarios" unique_id=878974265]
script = ExtResource("110_wv8uv")
scenario_name = "Prologue. Opening the Road"
scenario_id = "alderbrook_00_opening_the_road"
campaign_id = "road_to_alderbrook"
campaign_mission = 1
scenario_description = "Road to Alderbrook - prologue.

The company has concentrated its fire support against a thin enemy roadblock. Open the road at A and secure the farm at B. Three rifle squads, two machine-gun teams, a light mortar, platoon headquarters and company headquarters are available, with a four-gun 105 mm battery off map.

Establish machine-gun cover before advancing the rifles. Use the Fire Support tray to order mortar or artillery fire against spotted positions; keep your own troops clear of the target area. The enemy is dispersed between the road and farm, so one bombardment will not clear every position.

[b]Major Victory:[/b] hold A and B for 15 seconds each.

[b]Minor Victory:[/b] hold A for 15 seconds at the deadline. Either victory opens Quiet Approach.

[b]Next assignment:[/b] the company and heavy weapons will continue along the main road. A small rifle patrol with platoon HQ will check the flank toward Alderbrook without fire support."
duration_s = 600.0
use_authored_duration = true
released = true
offboard_batteries = Array[ExtResource("111_n7hvg")]([ExtResource("112_eh1wx")])
player_team = 1
victory_conditions = Array[ExtResource("113_i7fqp")]([SubResource("Resource_v13uw"), SubResource("Resource_n8dhh"), SubResource("Resource_id4m7"), SubResource("Resource_81yaa")])
axis_ai_status = 1
allies_ai_status = 0

