[node name="Mission" type="Node2D" parent="Scenarios" unique_id=806959735]
script = ExtResource("47_hsovp")
scenario_name = "5. Battle for Alderbrook"
scenario_id = "alderbrook_05_battle_for_alderbrook"
campaign_id = "road_to_alderbrook"
campaign_mission = 5
scenario_description = "Road to Alderbrook - mission 5 of 5.

The full company attacks across three bridge approaches into the village. You have three rifle platoons, their machine-gun teams, company headquarters, and a light mortar. Give each platoon a district, establish covering fire, and keep a reserve until the defense shows a weakness. Enemy survivors may try to escape east after their command post falls; secure the exit routes before the final assault.

[b]Major Victory:[/b] hold A, B, and C for 45 seconds each, destroy six enemy units, and allow no more than one enemy exit. Victory is assessed at the deadline.

[b]Minor Victory:[/b] hold the central square at B and destroy three enemy units. The defenders have a withdrawal fallback, so capturing ground alone is insufficient."
duration_s = 900.0
use_authored_duration = true
released = true
player_team = 1
victory_conditions = Array[ExtResource("48_j75m7")]([SubResource("Resource_m5tve"), SubResource("Resource_640b4"), SubResource("Resource_fhlvw"), SubResource("Resource_r28t1"), SubResource("Resource_ilf4m"), SubResource("Resource_uam5t"), SubResource("Resource_ao1lx"), SubResource("Resource_jqe2x"), SubResource("Resource_fflgn"), SubResource("Resource_ychgx"), SubResource("Resource_d3vmv"), SubResource("Resource_xby52")])
