[node name="Mission" type="Node2D" parent="Scenarios" unique_id=863863419]
script = ExtResource("47_hsovp")
scenario_name = "5. Battle for Alderbrook"
scenario_id = "alderbrook_05_battle_for_alderbrook"
campaign_id = "road_to_alderbrook"
campaign_mission = 5
scenario_description = "Road to Alderbrook - mission 5 of 5.

Your company attacks from farmland into Alderbrook. Hedges divide the fields, an orchard screens the northern estate, and scattered timber farms lead toward denser town blocks. Branching roads and garden lanes connect the approaches. A small pond lies off the southern flank; there is no river crossing.

[b]A - Orchard estate:[/b] clear the orchard edge and take the stone estate house. Its garden walls give the defenders covered positions, with openings toward the lanes.
[b]B - Market hall:[/b] the main road bends into the town center. Houses and workshop courts break the sight lines. Use a flank street to reach the hall rather than sending the company down the open road.
[b]C - Timber yard:[/b] barns, sheds and hedged gardens form the southern approach. Capture the large workshop, then move through the connecting streets toward the market.

Three rifle platoons, machine-gun teams, company headquarters and a light mortar support the attack. Establish covering fire and keep a reserve able to switch between districts. Enemy survivors may withdraw through the eastern roads after their defense breaks.

[b]Major Victory:[/b] hold A, B and C for 45 seconds each, destroy six enemy units, and allow no more than one enemy exit. Victory is assessed at the deadline.

[b]Minor Victory:[/b] hold B for 45 seconds and destroy three enemy units at the deadline."
duration_s = 900.0
use_authored_duration = true
released = true
player_team = 1
victory_conditions = Array[ExtResource("48_j75m7")]([SubResource("Resource_r28t1"), SubResource("Resource_ilf4m"), SubResource("Resource_uam5t"), SubResource("Resource_ao1lx"), SubResource("Resource_jqe2x"), SubResource("Resource_fflgn"), SubResource("Resource_ychgx"), SubResource("Resource_d3vmv"), SubResource("Resource_xby52"), SubResource("Resource_2oei0"), SubResource("Resource_2p27w"), SubResource("Resource_ekfsu")])
ai_fallback_policies = Array[ExtResource("53_xii21")]([SubResource("Resource_jw6pl")])
axis_ai_status = 1
allies_ai_status = 0

