[node name="Mission" type="Node2D" parent="Scenarios" unique_id=863863419]
script = ExtResource("47_hsovp")
scenario_name = "5. Battle for Alderbrook"
scenario_id = "alderbrook_05_battle_for_alderbrook"
campaign_id = "road_to_alderbrook"
campaign_mission = 5
scenario_description = "Road to Alderbrook - mission 5 of 5.

Three platoons with machine-gun teams and a light mortar must take Alderbrook. Advance through the fields and gardens to secure the orchard estate at A, market hall at B and timber yard at C. Use covering fire and keep a reserve to cut off enemy withdrawals to the east.

[b]Major Victory:[/b] hold A, B and C for 45 seconds each, destroy six enemy units and allow no more than four enemy exits by the deadline. The battle can end early once no active enemy remains and all three objectives are secured.

[b]Minor Victory:[/b] hold B for 45 seconds and destroy three enemy units by the deadline."
duration_s = 900.0
use_authored_duration = true
end_when_objectives_secured_and_enemy_gone = true
released = true
player_team = 1
