Debug="*res://autoloads/debug.gd"
MovementSystem="*uid://dla50r83yg10r"
LOS="*uid://bkkx84cy8adyu"
ThreatMap="*uid://smksvypix41r"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/Todo_Manager/plugin.cfg", "res://addons/ai_assistant_hub/plugin.cfg", "res://addons/hexagon_tilemaplayer/plugin.cfg")

